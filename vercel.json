{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node tools/stamp.mjs",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/stress-3d", "destination": "/stress-world", "permanent": true },
    { "source": "/handoff", "destination": "/handoff/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/examples/emberdeep.html" },
    { "source": "/:page(emberdeep|arena|stress-test|perspective-lab|mocap-lab|scarfrunner-side|labs|shapes-compare|free-camera|lab-3d|stress-world|vesper-ui)", "destination": "/examples/:page.html" },
    { "source": "/labs.html", "destination": "/examples/labs.html" },
    { "source": "/cmu-lib/:file", "destination": "/examples/cmu-lib/:file" },
    { "source": "/kits/:kit(adventure|animlab|brawler|platformer|rpg|shooter|stealth)", "destination": "/dist/kits/my-3d2dge-:kit.html" },
    { "source": "/handoff/", "destination": "/dist/handoff/index.html" },
    { "source": "/handoff/:file(.+)", "destination": "/dist/handoff/:file" }
  ]
}
