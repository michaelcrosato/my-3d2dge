{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node tools/stamp.mjs",
  "ignoreCommand": "P=$VERCEL_GIT_PREVIOUS_SHA; [ -n \"$P\" ] || exit 1; F=$(git diff --name-only \"$P\" HEAD) || exit 1; echo \"$F\" | grep -qvE '^(src|tools)/' && exit 1; echo \"$F\" | grep -qx tools/stamp.mjs && exit 1; exit 0",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/:page(stress-3d|stress-world|lab-3d)", "destination": "/3d", "permanent": true },
    { "source": "/vesper-ui", "destination": "/labs", "permanent": true },
    { "source": "/handoff", "destination": "/handoff/", "permanent": false },
    { "source": "/cmu-lib/:file", "missing": [{ "type": "host", "value": "my-3d2dge.vercel.app" }], "destination": "https://my-3d2dge.vercel.app/cmu-lib/:file", "permanent": false },
    { "source": "/:page(shapes-compare|free-camera|asset-probe)", "destination": "/asset-lab", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/examples/emberdeep.html" },
    { "source": "/:page(emberdeep|arena|stress-test|perspective-lab|mocap-lab|scarfrunner-side|labs|asset-lab|vehicle-lab)", "destination": "/examples/:page.html" },
    { "source": "/labs.html", "destination": "/examples/labs.html" },
    { "source": "/cmu-lib/:file", "destination": "/examples/cmu-lib/:file" },
    { "source": "/kits/:kit(adventure|animlab|arcade|brawler|fighting|kart|metroidvania|platformer|puzzle|road|roguelike|rpg|shooter|stealth|tactics|rts|sim|pointclick|pinball|artillery|rhythm|3d-action|3d-platformer|3d-shooter|3d-horror)", "destination": "/dist/kits/my-3d2dge-:kit.html" },
    { "source": "/3d", "destination": "/dist/my-3d2dge-3d.html" },
    { "source": "/handoff/", "destination": "/dist/handoff/index.html" },
    { "source": "/handoff/:file(.+)", "destination": "/dist/handoff/:file" }
  ]
}
