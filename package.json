{
  "name": "my-3d2dge",
  "version": "0.12.1",
  "description": "my-3D2dge (My \"3D\" 2D Game Engine): a general-purpose retro-modern 2D game engine built for AI models. Port, remaster, reimagine and remix 8-bit to 64-bit era games in every classic view, from one self-contained HTML file.",
  "type": "module",
  "license": "MIT",
  "main": "engine/my-3d2dge.js",
  "repository": { "type": "git", "url": "https://github.com/michaelcrosato/my-3d2dge.git" },
  "homepage": "https://github.com/michaelcrosato/my-3d2dge",
  "keywords": ["game-engine", "pixel-art", "retro", "2d", "isometric", "platformer", "procedural-animation", "llm", "ai"],
  "files": ["engine/my-3d2dge.js", "engine/my-3d2dge-agent.js", "API.md", "AI_GUIDE.md", "dist/"],
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "version:check": "node tools/version.mjs --check",
    "stamp": "node tools/stamp.mjs",
    "pretest": "npm run build",
    "test": "node tools/version.mjs --check && node tools/ed-syntax.mjs --all && node tools/ed-controls-test.mjs && node tools/ed-codex-test.mjs && node tools/ed-character-test.mjs && node tools/new-character.mjs --test && node tools/ed-tune-test.mjs && node tools/agent-test.mjs && node tools/mocap-test.mjs && node tools/ed-clips-test.mjs && node tools/labs-test.mjs && node tools/lab3d-test.mjs",
    "test:agent": "node tools/agent-test.mjs",
    "test:labs": "node tools/labs-test.mjs",
    "test:lab3d": "node tools/lab3d-test.mjs",
    "vendor:3d": "node tools/vendor-3d.mjs",
    "test:mocap": "node tools/mocap-test.mjs && node tools/ed-clips-test.mjs",
    "mocap:import": "node tools/anim-import.mjs",
    "mocap:set": "node tools/anim-set.mjs",
    "mocap:sheet": "node tools/anim-sheet.mjs",
    "mocap:cmu": "node tools/cmu.mjs",
    "test:smoke": "node tools/ed-smoke.mjs",
    "test:character": "node tools/ed-character-test.mjs",
    "character:check": "node tools/character-check.mjs",
    "character:sheet": "node tools/ed-sheet.mjs",
    "character:balance": "node tools/ed-balance.mjs",
    "new:character": "node tools/new-character.mjs",
    "test:codex": "npm run build && node tools/ed-codex-test.mjs",
    "showcase:codex": "node tools/ed-codex-showcase.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "terser": "^5.51.2"
  }
}
